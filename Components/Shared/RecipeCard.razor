@inject RecipeService Recipes
@inject AuthState Auth

<article class="card flex flex-col">
    <div class="h-32 bg-orange-50 flex items-center justify-center text-6xl">@Recipe.Emoji</div>
    <div class="p-4 flex flex-col gap-2 flex-1">
        <div class="flex items-start justify-between gap-2">
            <h3 class="font-display text-lg font-semibold leading-tight">@Recipe.Title</h3>
            <button title="Favorite" class="text-xl" @onclick="Favorite">@(IsFav ? "❤️" : "🤍")</button>
        </div>
        <span class="text-xs text-basil font-semibold uppercase tracking-wide">@Recipe.Cuisine</span>
        <p class="text-sm text-stone-600">@Recipe.Description</p>
        <div class="flex items-center justify-between text-sm text-stone-500 mt-auto pt-2">
            <span>@(Recipe.Reviews.Count == 0 ? "No ratings" : $"⭐ {Recipe.AverageRating:0.0} ({Recipe.Reviews.Count})")</span>
            <span>⏱ @Recipe.CookTimeMinutes min</span>
        </div>
        <p class="text-xs text-stone-400">by @Recipe.AuthorName</p>
        <button class="btn-basil self-start" @onclick="() => open = !open">@(open ? "Hide details" : "View & review")</button>

        @if (open)
        {
            <div class="border-t pt-3 text-sm space-y-3">
                <div>
                    <p class="font-semibold">Ingredients</p>
                    <ul class="list-disc ml-5">@foreach (var i in Recipe.Ingredients) { <li>@i</li> }</ul>
                </div>
                <div>
                    <p class="font-semibold">Steps</p>
                    <ol class="list-decimal ml-5">@foreach (var s in Recipe.Steps) { <li>@s</li> }</ol>
                </div>
                <div>
                    <p class="font-semibold">Reviews</p>
                    @foreach (var r in Recipe.Reviews)
                    {
                        <p class="text-stone-600"><b>@r.UserName</b> @(new string('⭐', r.Rating)) — @r.Comment</p>
                    }
                </div>
                <div class="space-y-2">
                    <select class="input" @bind="rating">
                        @for (var n = 5; n >= 1; n--)
                        {
                            <option value="@n">@n ⭐</option>
                        }
                    </select>
                    <input class="input" placeholder="Write a review…" @bind="comment" @bind:event="oninput" />
                    <button class="btn-primary" @onclick="Submit">Post review</button>
                </div>
            </div>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Recipe Recipe { get; set; } = default!;

    private bool open;
    private int rating = 5;
    private string comment = "";
    private bool IsFav => Auth.CurrentUser?.FavoriteRecipeIds.Contains(Recipe.Id) ?? false;

    private void Favorite() => Recipes.ToggleFavorite(Auth.CurrentUser!, Recipe.Id);

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(comment)) return;
        Recipes.AddReview(Recipe.Id, Auth.CurrentUser!, rating, comment.Trim());
        comment = "";
    }
}
