@page "/dashboard"
@implements IDisposable
@inject AuthState Auth
@inject RecipeService Recipes
@inject NavigationManager Nav

@if (Auth.IsLoggedIn)
{
    <section class="relative mb-8 overflow-hidden rounded-[30px] border border-orange-300/30 bg-gradient-to-br from-stone-950 via-stone-900 to-orange-950 shadow-[0_25px_80px_rgba(251,146,60,0.2)]">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(251,146,60,0.38),_transparent_30%),radial-gradient(circle_at_bottom_right,_rgba(251,191,36,0.25),_transparent_28%)]"></div>

        <div class="relative grid gap-6 px-6 py-6 sm:px-8 sm:py-8 lg:grid-cols-[1.4fr_0.6fr] lg:items-end">
            <div class="space-y-5">
                <span class="inline-flex items-center rounded-full border border-orange-300/40 bg-orange-500/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.24em] text-orange-100">
                    Fresh picks today
                </span>

                <div>
                    <h1 class="font-display text-4xl font-black tracking-[-0.06em] text-white sm:text-5xl lg:text-7xl">
                        Cook.<br />
                        Share.<br />
                        Savor.
                    </h1>
                    <p class="mt-4 max-w-xl text-sm text-stone-300 sm:text-base">
                        Welcome back, @Auth.CurrentUser!.Username! Discover vibrant dishes, save your favorites, and inspire your next culinary moment.
                    </p>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                    <button class="btn-primary shadow-lg shadow-orange-500/30 transition hover:-translate-y-0.5 hover:shadow-xl hover:shadow-orange-500/40" @onclick="() => showForm = !showForm">
                        + Share a recipe
                    </button>
                    <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-stone-200">
                        24 new ideas this week
                    </span>
                </div>
            </div>

            <div class="relative flex items-end justify-center lg:justify-end">
                <div class="relative w-full max-w-xs rounded-[24px] border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
                    <div class="absolute -left-6 top-8 h-20 w-20 rounded-full bg-orange-400/30 blur-2xl"></div>
                    <div class="relative space-y-4">
                        <div class="flex items-center justify-between text-xs uppercase tracking-[0.2em] text-orange-100/80">
                            <span>Trending</span>
                            <span>🔥</span>
                        </div>
                        <div class="space-y-2">
                            <div class="text-3xl font-black text-white">18k</div>
                            <div class="text-sm text-stone-300">recipes shared this month</div>
                        </div>
                        <div class="grid grid-cols-2 gap-3 pt-2">
                            <div class="rounded-2xl bg-stone-900/70 p-3">
                                <div class="text-[10px] uppercase tracking-[0.18em] text-stone-400">Top vibe</div>
                                <div class="mt-2 text-lg font-bold text-orange-200">Cozy</div>
                            </div>
                            <div class="rounded-2xl bg-stone-900/70 p-3">
                                <div class="text-[10px] uppercase tracking-[0.18em] text-stone-400">Quick</div>
                                <div class="mt-2 text-lg font-bold text-yellow-200">15 min</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @if (showForm)
    {
        <section class="card p-6 mb-8 hover:translate-y-0 space-y-3">
            <h2 class="font-display text-xl font-semibold">New recipe</h2>
            <input class="input" placeholder="Title" @bind="draft.Title" />
            <div class="grid sm:grid-cols-2 gap-3">
                <select class="input" @bind="draft.Cuisine">
                    @foreach (var c in Recipes.Cuisines)
                    {
                        <option value="@c.Name">@c.Emoji @c.Name</option>
                    }
                </select>
                <input class="input" type="number" placeholder="Cook time (min)" @bind="draft.CookTimeMinutes" />
            </div>
            <textarea class="input" rows="2" placeholder="Short description" @bind="draft.Description"></textarea>
            <textarea class="input" rows="3" placeholder="Ingredients (one per line)" @bind="ingredients"></textarea>
            <textarea class="input" rows="3" placeholder="Steps (one per line)" @bind="steps"></textarea>
            <div class="flex gap-3">
                <button class="btn-primary" @onclick="Post">Publish</button>
                <button class="text-stone-500" @onclick="() => showForm = false">Cancel</button>
            </div>
        </section>
    }

    <section class="flex flex-wrap gap-2 mb-8">
        <span class="chip @(cuisine is null ? "chip-active" : "")" @onclick="() => cuisine = null">All</span>
        @foreach (var c in Recipes.Cuisines)
        {
            <span class="chip @(cuisine == c.Name ? "chip-active" : "")" @onclick="() => cuisine = c.Name">@c.Emoji @c.Name</span>
        }
    </section>

    <section class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var r in Recipes.GetAll(cuisine))
        {
            <RecipeCard Recipe="r" @key="r.Id" />
        }
    </section>
}

@code {
    private string? cuisine;
    private bool showForm;
    private Recipe draft = new() { Cuisine = "Italian", CookTimeMinutes = 30 };
    private string ingredients = "", steps = "";

    protected override void OnInitialized()
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("/");
            return;
        }

        Recipes.Changed += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private static List<string> Lines(string text) =>
        text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private void Post()
    {
        if (string.IsNullOrWhiteSpace(draft.Title)) return;

        draft.Ingredients = Lines(ingredients);
        draft.Steps = Lines(steps);
        Recipes.Add(draft, Auth.CurrentUser!);
        draft = new() { Cuisine = "Italian", CookTimeMinutes = 30 };
        ingredients = steps = "";
        showForm = false;
    }

    public void Dispose() => Recipes.Changed -= Refresh;
}
