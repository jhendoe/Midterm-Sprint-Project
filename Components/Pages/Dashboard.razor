@page "/dashboard"
@implements IDisposable
@inject AuthState Auth
@inject RecipeService Recipes
@inject NavigationManager Nav

@if (Auth.IsLoggedIn)
{
    var all = Recipes.GetAll().ToList();
    var spot = all.FirstOrDefault();
    var reviewCount = all.Sum(r => r.Reviews.Count);

    <section class="relative mb-10 overflow-hidden rounded-[36px] border border-orange-300/20 bg-stone-950 shadow-[0_30px_90px_rgba(251,146,60,0.22)]">
        @* Atmosphere: warm glows + dotted texture *@
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_15%_10%,rgba(251,146,60,0.40),transparent_35%),radial-gradient(circle_at_90%_85%,rgba(244,63,94,0.28),transparent_35%)]"></div>
        <div class="absolute inset-0 opacity-70 [background-image:radial-gradient(rgba(255,255,255,0.08)_1px,transparent_1px)] [background-size:22px_22px]"></div>

        <div class="relative grid items-center gap-10 px-6 pt-10 pb-12 sm:px-10 lg:grid-cols-[1.15fr_0.85fr] lg:pt-14">

            @* ---------- LEFT: headline + actions ---------- *@
            <div class="space-y-7">
                <span class="inline-flex items-center gap-2 rounded-full border border-orange-300/30 bg-orange-500/10 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.22em] text-orange-100">
                    <span class="relative flex h-2 w-2">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-orange-400 opacity-75 motion-reduce:animate-none"></span>
                        <span class="relative inline-flex h-2 w-2 rounded-full bg-orange-400"></span>
                    </span>
                    Fresh picks today
                </span>

                <h1 class="font-display font-black leading-[0.88] tracking-[-0.05em] text-6xl sm:text-7xl lg:text-[7rem]">
                    <span class="block text-white">Cook.</span>
                    <span class="block text-transparent [-webkit-text-stroke:2px_rgb(253_186_116)]">Share.</span>
                    <span class="block bg-gradient-to-r from-amber-200 via-orange-400 to-rose-500 bg-clip-text italic text-transparent">Savor.</span>
                </h1>

                <p class="max-w-md text-base text-stone-300">
                    Welcome back, <span class="font-semibold text-orange-200">@Auth.CurrentUser!.Username</span>.
                    Find your next obsession, save the keepers, and show the world what's on your stove.
                </p>

                <div class="flex flex-wrap items-center gap-3">
                    <button class="btn-primary px-7 py-3 text-base shadow-lg shadow-orange-500/30 transition hover:-translate-y-0.5 hover:shadow-xl hover:shadow-orange-500/40"
                            @onclick="() => showForm = !showForm">
                        + Share a recipe
                    </button>
                    <a href="/dashboard#cuisines"
                       class="rounded-full border border-white/20 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
                        Explore cuisines ↓
                    </a>
                </div>

                @* Live stats from real data *@
                <dl class="flex gap-8 border-t border-white/10 pt-6">
                    <div>
                        <dt class="text-[10px] uppercase tracking-[0.2em] text-stone-400">Recipes</dt>
                        <dd class="font-display text-3xl font-bold text-white">@all.Count</dd>
                    </div>
                    <div>
                        <dt class="text-[10px] uppercase tracking-[0.2em] text-stone-400">Cuisines</dt>
                        <dd class="font-display text-3xl font-bold text-white">@Recipes.Cuisines.Count</dd>
                    </div>
                    <div>
                        <dt class="text-[10px] uppercase tracking-[0.2em] text-stone-400">Reviews</dt>
                        <dd class="font-display text-3xl font-bold text-white">@reviewCount</dd>
                    </div>
                </dl>
            </div>

            @* ---------- RIGHT: the plate ---------- *@
            @if (spot is not null)
            {
                <div class="relative mx-auto h-72 w-72 sm:h-96 sm:w-96">
                    <div class="absolute inset-0 rounded-full bg-orange-500/30 blur-3xl"></div>

                    @* dashed orbit ring *@
                    <div class="absolute -inset-4 animate-[spin_40s_linear_infinite] rounded-full border border-dashed border-orange-300/30 motion-reduce:animate-none"></div>

                    @* plate rim + dish *@
                    <div class="absolute inset-0 rounded-full bg-gradient-to-br from-amber-200 via-orange-400 to-rose-500 p-3 shadow-2xl shadow-orange-600/40">
                        <div class="flex h-full w-full items-center justify-center rounded-full bg-stone-950 text-[8rem] sm:text-[10rem]">
                            <span class="animate-float drop-shadow-[0_12px_20px_rgba(0,0,0,0.6)] motion-reduce:animate-none">@spot.Emoji</span>
                        </div>
                    </div>

                    @* floating sticker: spotlight recipe *@
                    <div class="absolute -left-4 top-6 animate-float rounded-2xl border border-white/10 bg-stone-900/90 px-4 py-3 shadow-xl backdrop-blur motion-reduce:animate-none sm:-left-10">
                        <div class="text-[10px] uppercase tracking-[0.2em] text-orange-200/80">Spotlight</div>
                        <div class="font-display text-sm font-bold text-white">@spot.Title</div>
                        <div class="text-xs text-stone-400">
                            @(spot.Reviews.Count == 0 ? "Be the first to review" : $"⭐ {spot.AverageRating:0.0} · {spot.Reviews.Count} reviews")
                        </div>
                    </div>

                    @* floating sticker: cook time *@
                    <div class="absolute -right-2 bottom-16 animate-float-slow rounded-full bg-white px-4 py-2 text-sm font-bold text-stone-900 shadow-xl motion-reduce:animate-none sm:-right-8">
                        ⏱ @spot.CookTimeMinutes min
                    </div>

                    @* rotating text badge *@
                    <div class="absolute -bottom-6 -left-2 flex h-28 w-28 items-center justify-center sm:left-2">
                        <div class="absolute inset-0 animate-spin-slow motion-reduce:animate-none">@((MarkupString)BadgeSvg)</div>
                        <span class="text-2xl">🍴</span>
                    </div>
                </div>
            }
        </div>

        @* ---------- Cuisine ticker ---------- *@
        <div class="relative overflow-hidden border-t border-white/10 bg-black/30 py-3">
            <div class="flex w-max animate-marquee gap-10 motion-reduce:animate-none">
                @for (var i = 0; i < 2; i++)
                {
                    @foreach (var c in Recipes.Cuisines)
                    {
                        <span class="whitespace-nowrap text-xs font-semibold uppercase tracking-[0.3em] text-orange-100/70">
                            @c.Emoji @c.Name <span class="ml-10 text-orange-400">✦</span>
                        </span>
                    }
                }
            </div>
        </div>
    </section>

    @if (showForm)
    {
        <section class="card p-6 mb-8 hover:translate-y-0 space-y-3">
            <h2 class="font-display text-xl font-semibold">New recipe</h2>
            <input class="input" placeholder="Title" @bind="draft.Title" />
            <div class="grid sm:grid-cols-2 gap-3">
                <select class="input" @bind="draft.Cuisine">
                    @foreach (var c in Recipes.Cuisines)
                    {
                        <option value="@c.Name">@c.Emoji @c.Name</option>
                    }
                </select>
                <input class="input" type="number" placeholder="Cook time (min)" @bind="draft.CookTimeMinutes" />
            </div>
            <textarea class="input" rows="2" placeholder="Short description" @bind="draft.Description"></textarea>
            <textarea class="input" rows="3" placeholder="Ingredients (one per line)" @bind="ingredients"></textarea>
            <textarea class="input" rows="3" placeholder="Steps (one per line)" @bind="steps"></textarea>
            <div class="flex gap-3">
                <button class="btn-primary" @onclick="Post">Publish</button>
                <button class="text-stone-500" @onclick="() => showForm = false">Cancel</button>
            </div>
        </section>
    }

    <section id="cuisines" class="flex flex-wrap gap-2 mb-8 scroll-mt-24">
        <span class="chip @(cuisine is null ? "chip-active" : "")" @onclick="() => cuisine = null">All</span>
        @foreach (var c in Recipes.Cuisines)
        {
            <span class="chip @(cuisine == c.Name ? "chip-active" : "")" @onclick="() => cuisine = c.Name">@c.Emoji @c.Name</span>
        }
    </section>

    <section class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var r in Recipes.GetAll(cuisine))
        {
            <RecipeCard Recipe="r" @key="r.Id" />
        }
    </section>
}

@code {
    private string? cuisine;
    private bool showForm;
    private Recipe draft = new() { Cuisine = "Italian", CookTimeMinutes = 30 };
    private string ingredients = "", steps = "";

    // Circular text badge. Built as a string so Razor doesn't treat <text> as a code-block tag.
    private const string BadgeSvg =
        "<svg viewBox='0 0 120 120' class='h-full w-full'>" +
        "<circle cx='60' cy='60' r='58' fill='#1c1917' stroke='rgba(253,186,116,0.4)'/>" +
        "<defs><path id='badgeCircle' d='M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0'/></defs>" +
        "<text fill='#fed7aa' font-size='10' font-weight='700' letter-spacing='3'>" +
        "<textPath href='#badgeCircle'>FRESH • HOMEMADE • SHARED • </textPath></text></svg>";

    protected override void OnInitialized()
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("/");
            return;
        }

        Recipes.Changed += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private static List<string> Lines(string text) =>
        text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private void Post()
    {
        if (string.IsNullOrWhiteSpace(draft.Title)) return;

        draft.Ingredients = Lines(ingredients);
        draft.Steps = Lines(steps);
        Recipes.Add(draft, Auth.CurrentUser!);
        draft = new() { Cuisine = "Italian", CookTimeMinutes = 30 };
        ingredients = steps = "";
        showForm = false;
    }

    public void Dispose() => Recipes.Changed -= Refresh;
}
