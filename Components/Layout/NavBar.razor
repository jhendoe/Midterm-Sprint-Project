@implements IDisposable
@inject AuthState Auth
@inject NavigationManager Nav

<header class="bg-white border-b border-stone-200 sticky top-0 z-10">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/dashboard" class="font-display text-2xl font-bold text-tomato">🍳 FoodieHub</a>
        @if (Auth.IsLoggedIn)
        {
            <nav class="flex items-center gap-6 text-sm font-medium">
                <a href="/dashboard" class="hover:text-tomato">Dashboard</a>
                <a href="/profile" class="hover:text-tomato">@Auth.CurrentUser!.Avatar Profile</a>
                <button class="text-stone-500 hover:text-tomato" @onclick="Logout">Logout</button>
            </nav>
        }
    </div>
</header>

@code {
    protected override void OnInitialized() => Nav.LocationChanged += OnLocation;

    private void OnLocation(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private void Logout()
    {
        Auth.Logout();
        Nav.NavigateTo("/");
    }

    public void Dispose() => Nav.LocationChanged -= OnLocation;
}
